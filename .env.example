# Copy to .env.local and fill in. .env.local is gitignored.
# In production (Vercel), set these in Project → Settings → Environment Variables.

# Supabase — Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Hero portrait — public URL of the headshot in Supabase Storage.
# Defaults to the existing image in the portfolio-media bucket; override here
# if you re-upload under a different name.
# NEXT_PUBLIC_HEADSHOT_URL=https://<project>.supabase.co/storage/v1/object/public/portfolio-media/hero/your-headshot.jpg

# Resend — for contact form email notifications (optional but recommended)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=deeptisemwal1235@gmail.com
# Optional: a verified sender. Until you verify a domain, leave as the Resend default.
# RESEND_FROM_EMAIL=Deepti Portfolio <hello@yourdomain.com>
